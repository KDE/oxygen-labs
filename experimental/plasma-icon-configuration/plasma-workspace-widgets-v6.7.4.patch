+        auto badCondition = data;
+        badCondition.replace("\"equals\": false", "\"equals\": \"false\"");
+        QTest::newRow("non-boolean-condition") << badCondition;
+        auto destination = data;
+        destination.replace("\"type\": \"userThemeCopy\"", "\"type\": \"systemTheme\"");
+        QTest::newRow("system-write-request") << destination;
