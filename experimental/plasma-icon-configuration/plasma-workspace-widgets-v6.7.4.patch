+    void testActualOxygen()
+    {
+        const auto source = qEnvironmentVariable("OXYGEN_TEST_SOURCE");
+        if (source.isEmpty()) {
+            QSKIP("Set OXYGEN_TEST_SOURCE to validate installed Oxygen.");
+        }
+        ThemeConfiguration configuration;
+        QString error;
+        QVERIFY2(readThemeConfiguration(source, configuration, error), qPrintable(error));
+        const auto output =
+            QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons/") + configuredThemeId(configuration.source);
+        QVERIFY(!QFileInfo::exists(output));
+        const auto remove = qScopeGuard([&]() {
+            QDir(output).removeRecursively();
+        });
+        QMap<QString, bool> values;
+        for (const auto &page : configuration.pages) {
+            for (const auto &control : page.controls) {
+                values.insert(control.id, false);
+            }
+        }
+        QVERIFY2(applyThemeConfiguration(configuration, values, error), qPrintable(error));
+        KIconTheme::forceThemeForTests(configuredThemeId(configuration.source));
+        KIconLoader loader;
+        for (int size : {16, 22, 24, 32, 48, 64, 128, 256}) {
+            for (qreal dpr : {1., 1.25, 1.5, 2.}) {
+                const auto path = loader.iconPath(QStringLiteral("network-wireless-100-symbolic"), -size, true, dpr);
+                QVERIFY2(path.startsWith(output + QStringLiteral("/base/")), qPrintable(path));
+                QVERIFY(!loader.loadScaledIcon(QStringLiteral("network-wireless-100-symbolic"), KIconLoader::NoGroup, dpr, QSize(size, size)).isNull());
+            }
+        }
+        ThemeConfiguration reopened;
+        QVERIFY2(readThemeConfiguration(output, reopened, error), qPrintable(error));
+        QCOMPARE(reopened.pages.size(), configuration.pages.size());
+    }
