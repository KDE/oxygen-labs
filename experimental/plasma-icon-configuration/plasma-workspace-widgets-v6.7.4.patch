diff --git a/kcms/icons/autotests/themeconfigtest.cpp b/kcms/icons/autotests/themeconfigtest.cpp
new file mode 100644
index 0000000..02af6dc
--- /dev/null
+++ b/kcms/icons/autotests/themeconfigtest.cpp
@@ -0,0 +1,379 @@
+// SPDX-FileCopyrightText: 2026 Oxygen contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "../themeconfig.h"
+#include <KConfig>
+#include <KConfigGroup>
+#include <KIconLoader>
+#include <KIconTheme>
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QScopeGuard>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+
+class ThemeConfigTest : public QObject
+{
+    Q_OBJECT
+    std::unique_ptr<QTemporaryDir> m_source;
+    QString m_output;
+    QJsonObject m_declaration;
+    static QJsonObject fixture()
+    {
+        return QJsonDocument::fromJson(R"({
+            "version":1,"title":"Fixture settings","description":"Plain-text description",
+            "pages":[{"title":"General","controls":[
+                {"id":"symbolic","type":"checkbox","label":"Symbolic artwork","default":true}]}],
+            "installation":{"type":"userThemeCopy","rules":[
+                {"when":{"control":"symbolic","equals":false},
+                 "operation":{"type":"omitDirectories","directories":["applets/32"]}}]}
+        })")
+            .object();
+    }
+    void write(const QString &relative, const QByteArray &bytes)
+    {
+        QFile file(m_source->path() + QLatin1Char('/') + relative);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        QCOMPARE(file.write(bytes), bytes.size());
+    }
+    void declaration(const QJsonObject &data)
+    {
+        write(QStringLiteral("icon-settings.json"), QJsonDocument(data).toJson());
+    }
+private Q_SLOTS:
+    void init()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        const QString fixtures = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons/.theme-config-fixtures");
+        QVERIFY(QDir().mkpath(fixtures));
+        m_source = std::make_unique<QTemporaryDir>(fixtures + QStringLiteral("/theme-XXXXXX"));
+        QVERIFY(m_source->isValid());
+        QVERIFY(QDir().mkpath(m_source->path() + QStringLiteral("/base/32")));
+        QVERIFY(QDir().mkpath(m_source->path() + QStringLiteral("/applets/32")));
+        write(QStringLiteral("index.theme"),
+              "[Icon Theme]\nName=Fixture\nName[pt]=Teste\nX-KDE-IconConfiguration=DeclarativeV1\nDirectories=base/32,applets/32\n"
+              "[base/32]\nSize=32\nType=Fixed\n[applets/32]\nSize=32\nType=Fixed\n");
+        write(QStringLiteral("base/32/test.svg"),
+              "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\"><rect width=\"32\" height=\"32\" fill=\"red\"/></svg>");
+        write(QStringLiteral("applets/32/test-symbolic.svg"),
+              "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\"><rect width=\"32\" height=\"32\" fill=\"blue\"/></svg>");
+        m_declaration = fixture();
+        declaration(m_declaration);
+        m_output = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons/") + configuredThemeId(m_source->path());
+    }
+    void cleanup()
+    {
+        KIconTheme::forceThemeForTests(QString());
+        if (QFileInfo(m_output).isSymLink()) {
+            QVERIFY(QFile::remove(m_output));
+        } else if (QFileInfo::exists(m_output)) {
+            QVERIFY(QDir(m_output).removeRecursively());
+        }
+        m_source.reset();
+    }
+    void testRoundTripAndFallback()
+    {
+        ThemeConfiguration configuration;
+        QString error;
+        QVERIFY2(readThemeConfiguration(m_source->path(), configuration, error), qPrintable(error));
+        QCOMPARE(configuration.pages[0].controls[0].defaultValue, true);
+        QVERIFY2(applyThemeConfiguration(configuration, {{QStringLiteral("symbolic"), true}}, error), qPrintable(error));
+        QVERIFY(QFileInfo::exists(m_output + QStringLiteral("/applets/32/test-symbolic.svg")));
+        QVERIFY(!QFileInfo(m_output + QStringLiteral("/base/32/test.svg")).isSymLink());
+        QVERIFY2(applyThemeConfiguration(configuration, {{QStringLiteral("symbolic"), false}}, error), qPrintable(error));
+        QVERIFY(!QFileInfo::exists(m_output + QStringLiteral("/applets/32")));
+        ThemeConfiguration reopened;
+        QVERIFY2(readThemeConfiguration(m_output, reopened, error), qPrintable(error));
+        QCOMPARE(reopened.source, configuration.source);
+        KConfig saved(m_output + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+        QCOMPARE(configuredThemeId(configuration.source), QFileInfo(m_source->path()).fileName());
+        QCOMPARE(KConfigGroup(&saved, QStringLiteral("Icon Theme")).readEntry("Name", QString()), QStringLiteral("Fixture"));
+        QFile index(m_output + QStringLiteral("/index.theme"));
+        QVERIFY(index.open(QIODevice::ReadOnly));
+        QVERIFY(index.readAll().contains("Name[pt]=Teste"));
+        QVERIFY(!KConfigGroup(&saved, QStringLiteral("X-KDE-IconConfigurationValues")).readEntry("symbolic", true));
+        QCOMPARE(KConfigGroup(&saved, QStringLiteral("Icon Theme")).readEntry("Directories", QStringList()), QStringList{QStringLiteral("base/32")});
+        KIconTheme::forceThemeForTests(configuredThemeId(configuration.source));
+        KIconLoader loader;
+        for (int size : {16, 22, 24, 32, 48, 64, 128, 256}) {
+            for (qreal dpr : {1., 1.25, 1.5, 2.}) {
+                QCOMPARE(loader.iconPath(QStringLiteral("test-symbolic"), -size, true, dpr), m_output + QStringLiteral("/base/32/test.svg"));
+            }
+        }
+        QVERIFY(QFileInfo::exists(m_source->path() + QStringLiteral("/applets/32/test-symbolic.svg")));
+        QVERIFY(!applyThemeConfiguration(configuration, {}, error));
+        QVERIFY(!applyThemeConfiguration(configuration, {{QStringLiteral("symbolic"), false}, {QStringLiteral("extra"), true}}, error));
+    }
+    void testUserThemeKeepsIdentityAndOriginalArtwork()
+    {
+        QVERIFY(QDir().mkpath(QFileInfo(m_output).path()));
+        QVERIFY(QDir().rename(m_source->path(), m_output));
+        const auto retained = QFileInfo(m_output).path() + QStringLiteral("/.icon-config-sources/") + QFileInfo(m_output).fileName();
