+        QTest::newRow("execute") << command;
+        auto script = fixture();
+        script.insert(QStringLiteral("command"), QStringLiteral("touch /tmp/no"));
+        QTest::newRow("unknown-field") << QJsonDocument(script).toJson();
+        auto badDefault = data;
+        badDefault.replace("\"default\": true", "\"default\": \"yes\"");
+        QTest::newRow("non-boolean-default") << badDefault;
+        auto unknownControl = data;
