+    void testDeclarationChangesWithoutCompilation()
+    {
+        auto document = fixture();
+        auto pages = document.value(QStringLiteral("pages")).toArray();
+        auto page = pages[0].toObject();
+        auto controls = page.value(QStringLiteral("controls")).toArray();
+        auto control = controls[0].toObject();
+        control.insert(QStringLiteral("default"), false);
+        control.insert(QStringLiteral("label"), QStringLiteral("Changed without compilation"));
+        controls[0] = control;
+        page.insert(QStringLiteral("controls"), controls);
+        pages[0] = page;
+        document.insert(QStringLiteral("pages"), pages);
+        declaration(document);
+        ThemeConfiguration configuration;
+        QString error;
+        QVERIFY(readThemeConfiguration(m_source->path(), configuration, error));
+        QCOMPARE(configuration.pages[0].controls[0].defaultValue, false);
+        QCOMPARE(configuration.pages[0].controls[0].label, QStringLiteral("Changed without compilation"));
+        // A declaration changed after opening must be validated again at Save.
+        document.insert(QStringLiteral("command"), QStringLiteral("forbidden"));
+        declaration(document);
+        QVERIFY(!applyThemeConfiguration(configuration, {{QStringLiteral("symbolic"), true}}, error));
+        QVERIFY(!QFileInfo::exists(m_output));
+    }
