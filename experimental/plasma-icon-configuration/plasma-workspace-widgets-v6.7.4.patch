+    void testReadOnlySystemTheme()
+    {
+        const QStringList paths{m_source->path() + QStringLiteral("/base/32/test.svg"),
+                                m_source->path() + QStringLiteral("/applets/32/test-symbolic.svg"),
+                                m_source->path() + QStringLiteral("/index.theme"),
+                                m_source->path() + QStringLiteral("/icon-settings.json")};
+        QMap<QString, QByteArray> originals;
+        for (const auto &path : paths) {
+            QFile file(path);
+            QVERIFY(file.open(QIODevice::ReadOnly));
+            originals.insert(path, file.readAll());
+            QVERIFY(QFile::setPermissions(path, QFile::ReadOwner | QFile::ReadGroup | QFile::ReadOther));
+        }
+        QStringList directories{m_source->path(),
+                                m_source->path() + QStringLiteral("/base"),
+                                m_source->path() + QStringLiteral("/base/32"),
+                                m_source->path() + QStringLiteral("/applets"),
+                                m_source->path() + QStringLiteral("/applets/32")};
+        const auto restore = qScopeGuard([&]() {
+            for (const auto &path : directories) {
+                QFile::setPermissions(path, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner);
+            }
+        });
+        for (const auto &path : directories) {
+            QVERIFY(QFile::setPermissions(path, QFile::ReadOwner | QFile::ExeOwner | QFile::ReadGroup | QFile::ExeGroup | QFile::ReadOther | QFile::ExeOther));
+        }
+        ThemeConfiguration configuration;
+        QString error;
+        QVERIFY(readThemeConfiguration(m_source->path(), configuration, error));
+        QVERIFY2(applyThemeConfiguration(configuration, {{QStringLiteral("symbolic"), false}}, error), qPrintable(error));
+        QVERIFY(QFileInfo(m_output).isWritable());
+        QVERIFY(QFileInfo(m_output + QStringLiteral("/index.theme")).isWritable());
+        for (auto i = originals.cbegin(); i != originals.cend(); ++i) {
+            QFile file(i.key());
+            QVERIFY(file.open(QIODevice::ReadOnly));
+            QCOMPARE(file.readAll(), i.value());
+            QVERIFY(!QFileInfo(i.key()).isWritable());
+        }
+    }
