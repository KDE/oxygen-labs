 IconModule::~IconModule() = default;
 
+void IconModule::configureIconTheme(const QString &themeName)
+{
+    const int row = pluginIndex(themeName);
+    if (row < 0 || !m_model->index(row, 0).data(IconsModel::ConfigurableRole).toBool()) {
+        Q_EMIT showErrorMessage(i18n("This icon theme has no supported configuration."));
+        return;
+    }
+    if (m_configurator) {
+        Q_EMIT showErrorMessage(i18n("The icon configuration dialog is already open."));
+        return;
+    }
+    if (iconsSettings()->isImmutable(QStringLiteral("Theme"))) {
+        Q_EMIT showErrorMessage(i18n("The icon theme selection is locked by your administrator."));
+        return;
+    }
+    const auto executable = QStandardPaths::findExecutable(QStringLiteral("plasma-icon-theme-config"), {QStringLiteral(CMAKE_INSTALL_FULL_LIBEXECDIR)});
+    if (executable.isEmpty()) {
+        Q_EMIT showErrorMessage(i18n("The System Settings icon configuration renderer is not installed."));
+        return;
+    }
+    KIconTheme theme(themeName);
+    ThemeConfiguration configuration;
+    QString error;
+    if (!readThemeConfiguration(theme.dir(), configuration, error)) {
+        Q_EMIT showErrorMessage(i18n("Unable to read icon configuration: %1", error));
+        return;
+    }
+    const auto configuredId = configuredThemeId(configuration.source);
+    auto *process = new QProcess(this);
+    m_configurator = process;
+    process->setProgram(executable);
+    process->setArguments({theme.dir()});
+    connect(process, &QProcess::errorOccurred, this, [this, process](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            Q_EMIT showErrorMessage(i18n("Unable to start the icon configurator: %1", process->errorString()));
+            m_configurator = nullptr;
+            process->deleteLater();
+        }
+    });
+    connect(process, &QProcess::finished, this, [this, process, configuredId](int code, QProcess::ExitStatus status) {
+        m_configurator = nullptr;
+        process->deleteLater();
+        if (status != QProcess::NormalExit || (code != 0 && code != 2)) {
+            Q_EMIT showErrorMessage(i18n("The icon configurator failed: %1", QString::fromUtf8(process->readAllStandardError())));
+            return;
+        }
+        if (code == 2) {
+            return;
+        }
+        const auto previousTheme = iconsSettings()->theme();
+        iconsSettings()->setTheme(configuredId);
+        if (!iconsSettings()->save()) {
+            iconsSettings()->setTheme(previousTheme);
+            Q_EMIT showErrorMessage(i18n("The artwork settings were saved, but the icon theme selection could not be saved."));
+            return;
+        }
+        KIconTheme::reconfigure();
+        KSharedDataCache::deleteCache(QStringLiteral("icon-cache"));
+        m_kiconThemeCache.clear();
+        QPixmapCache::clear();
+        m_model->load();
+        for (int group = 0; group < KIconLoader::LastGroup; ++group) {
+            KIconLoader::emitChange(static_cast<KIconLoader::Group>(group));
+        }
+        Q_EMIT showSuccessMessage(i18n("The icon theme settings have been saved and applied."));
+    });
+    process->start();
+}
+
 IconsSettings *IconModule::iconsSettings() const
 {
     return m_data->settings();
