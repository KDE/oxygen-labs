diff --git a/kcms/icons/themeconfig.cpp b/kcms/icons/themeconfig.cpp
new file mode 100644
index 0000000..dfd3206
--- /dev/null
+++ b/kcms/icons/themeconfig.cpp
@@ -0,0 +1,394 @@
+// SPDX-FileCopyrightText: 2026 Oxygen contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "themeconfig.h"
+#include <KConfig>
+#include <KConfigGroup>
+#include <QCryptographicHash>
+#include <QDir>
+#include <QDirIterator>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLockFile>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QSet>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <algorithm>
+
+namespace
+{
+bool fail(QString &error, const QString &message)
+{
+    error = message;
+    return false;
+}
+bool relativePath(const QString &path)
+{
+    return !path.isEmpty() && !QDir::isAbsolutePath(path) && QDir::cleanPath(path) == path && path != QLatin1String(".") && path != QLatin1String("..")
+        && !path.startsWith(QLatin1String("../")) && !path.contains(QLatin1Char('\\')) && !path.contains(QLatin1Char('\n'))
+        && !path.contains(QLatin1Char('\r'));
+}
+bool boundedText(const QJsonValue &value)
+{
+    return value.isString() && !value.toString().isEmpty() && value.toString().size() <= 1024;
+}
+bool keys(const QJsonObject &object, const QStringList &allowed)
+{
+    for (auto i = object.begin(); i != object.end(); ++i) {
+        if (!allowed.contains(i.key())) {
+            return false;
+        }
+    }
+    return true;
+}
+QString outputRoot()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons");
+}
+QString ownerPath(const QString &source)
+{
+    return outputRoot() + QLatin1Char('/') + configuredThemeId(source);
+}
+bool writableRoot(QString &error)
+{
+    const auto root = outputRoot();
+    if (!QDir().mkpath(root)) {
+        return fail(error, QStringLiteral("Cannot create the user icon directory."));
+    }
+    if (QFileInfo(root).canonicalFilePath() != QDir::cleanPath(root)) {
+        return fail(error, QStringLiteral("The user icon directory must not be a symlink."));
+    }
+    return true;
+}
+bool copyArtwork(const QString &source, const QString &destination)
+{
+    QFile input(source);
+    QFile output(destination);
+    if (!input.open(QIODevice::ReadOnly) || input.size() > 32 * 1024 * 1024 || !output.open(QIODevice::WriteOnly | QIODevice::NewOnly)) {
+        return false;
+    }
+    // Artwork is staged privately; avoid QFile::copy's per-file durable sync.
+    // Metadata and the final directory switch determine publication.
+    qint64 copied = 0;
+    while (!input.atEnd()) {
+        const auto data = input.read(65536);
+        copied += data.size();
+        if (data.isEmpty() || copied > 32 * 1024 * 1024 || output.write(data) != data.size()) {
+            return false;
+        }
+    }
+    return input.error() == QFile::NoError && output.flush()
+        && output.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ReadGroup | QFile::ReadOther);
+}
+}
+
+QString configuredThemeId(const QString &source)
+{
+    return QFileInfo(source).fileName();
+}
+
+bool readThemeConfiguration(const QString &directory, ThemeConfiguration &result, QString &error)
+{
+    result = {};
+    QString source = QFileInfo(directory).canonicalFilePath();
+    if (source.isEmpty()) {
+        return fail(error, QStringLiteral("The icon theme does not exist."));
+    }
+    const auto identity = configuredThemeId(source);
+    if (!relativePath(identity) || identity.startsWith(QLatin1Char('.'))) {
+        return fail(error, QStringLiteral("Invalid icon theme identity."));
+    }
+    KConfig index(source + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+    const KConfigGroup managed(&index, QStringLiteral("X-KDE-GeneratedIconConfiguration"));
+    if (managed.readEntry("Version", 0) == 1) {
+        const auto original = QFileInfo(managed.readEntry("Source", QString())).canonicalFilePath();
+        const QString legacyId =
+            QStringLiteral("configured-") + QString::fromLatin1(QCryptographicHash::hash(original.toUtf8(), QCryptographicHash::Sha256).toHex().left(16));
+        const QString legacyPath = outputRoot() + QLatin1Char('/') + legacyId;
+        if (original.isEmpty() || original == source
+            || (source != QFileInfo(ownerPath(original)).canonicalFilePath() && source != QFileInfo(legacyPath).canonicalFilePath())
+            || QFileInfo(directory).isSymLink()) {
+            return fail(error, QStringLiteral("Invalid generated theme source."));
+        }
+        source = original;
+    }
+    KConfig sourceIndex(source + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+    if (!QFileInfo(source + QStringLiteral("/index.theme")).canonicalFilePath().startsWith(source + QLatin1Char('/'))) {
+        return fail(error, QStringLiteral("Theme index escapes the source directory."));
+    }
+    if (sourceIndex.isImmutable()) {
+        return fail(error, QStringLiteral("Immutable theme metadata cannot be configured."));
+    }
+    for (const auto &name : sourceIndex.groupList()) {
+        const KConfigGroup group(&sourceIndex, name);
+        if (group.isImmutable()) {
+            return fail(error, QStringLiteral("Immutable theme metadata cannot be configured."));
+        }
+        for (const auto &key : group.keyList()) {
+            if (group.isEntryImmutable(key)) {
+                return fail(error, QStringLiteral("Immutable theme metadata cannot be configured."));
+            }
+        }
+    }
+    if (KConfigGroup(&sourceIndex, QStringLiteral("Icon Theme")).readEntry("X-KDE-IconConfiguration", QString()) != QLatin1String("DeclarativeV1")) {
+        return fail(error, QStringLiteral("This theme does not declare supported configuration."));
+    }
+    const auto root = source + QLatin1Char('/');
+    QFile manifest(root + QStringLiteral("icon-settings.json"));
+    if (!QFileInfo(manifest).canonicalFilePath().startsWith(root) || !manifest.open(QIODevice::ReadOnly) || manifest.size() > 65536) {
+        return fail(error, QStringLiteral("Cannot read the theme configuration declaration."));
+    }
+    QJsonParseError parseError;
+    const auto document = QJsonDocument::fromJson(manifest.readAll(), &parseError);
+    const auto object = document.object();
+    if (parseError.error != QJsonParseError::NoError || !document.isObject()
+        || !keys(object,
+                 {QStringLiteral("version"), QStringLiteral("title"), QStringLiteral("description"), QStringLiteral("pages"), QStringLiteral("installation")})
+        || object.value(QStringLiteral("version")) != QJsonValue(1) || !boundedText(object.value(QStringLiteral("title")))
+        || !boundedText(object.value(QStringLiteral("description"))) || !object.value(QStringLiteral("pages")).isArray()) {
+        return fail(error, QStringLiteral("Invalid theme configuration schema."));
+    }
+    const auto registered = KConfigGroup(&sourceIndex, QStringLiteral("Icon Theme")).readEntry("Directories", QStringList())
+        + KConfigGroup(&sourceIndex, QStringLiteral("Icon Theme")).readEntry("ScaledDirectories", QStringList());
+    for (const auto &path : registered) {
+        if (!relativePath(path)) {
+            return fail(error, QStringLiteral("Invalid registered icon directory."));
+        }
+    }
+    QSet<QString> ids;
+    QSet<QString> controlled;
+    const auto pages = object.value(QStringLiteral("pages")).toArray();
+    if (pages.isEmpty() || pages.size() > 8) {
+        return fail(error, QStringLiteral("Invalid page count."));
+    }
+    for (const auto &value : pages) {
+        const auto page = value.toObject();
+        if (!value.isObject() || !keys(page, {QStringLiteral("title"), QStringLiteral("controls")}) || !boundedText(page.value(QStringLiteral("title")))
+            || !page.value(QStringLiteral("controls")).isArray()) {
+            return fail(error, QStringLiteral("Invalid configuration page."));
+        }
+        ThemePage parsedPage{page.value(QStringLiteral("title")).toString(), {}};
+        const auto controls = page.value(QStringLiteral("controls")).toArray();
+        if (controls.isEmpty() || controls.size() > 64 || ids.size() + controls.size() > 64) {
+            return fail(error, QStringLiteral("Invalid control count."));
+        }
+        for (const auto &entry : controls) {
+            const auto control = entry.toObject();
+            const auto id = control.value(QStringLiteral("id")).toString();
+            static const QRegularExpression identifier(QStringLiteral("^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"));
+            if (!entry.isObject() || !keys(control, {QStringLiteral("id"), QStringLiteral("type"), QStringLiteral("label"), QStringLiteral("default")})
+                || !identifier.match(id).hasMatch() || ids.contains(id) || control.value(QStringLiteral("type")).toString() != QLatin1String("checkbox")
+                || !boundedText(control.value(QStringLiteral("label"))) || !control.value(QStringLiteral("default")).isBool()) {
+                return fail(error, QStringLiteral("Invalid or unsupported configuration control."));
+            }
+            ids.insert(id);
+            parsedPage.controls.append({id, control.value(QStringLiteral("label")).toString(), control.value(QStringLiteral("default")).toBool()});
+        }
+        result.pages.append(parsedPage);
+    }
+    const auto installation = object.value(QStringLiteral("installation")).toObject();
+    if (!object.value(QStringLiteral("installation")).isObject() || !keys(installation, {QStringLiteral("type"), QStringLiteral("rules")})
+        || installation.value(QStringLiteral("type")).toString() != QLatin1String("userThemeCopy") || !installation.value(QStringLiteral("rules")).isArray()) {
+        return fail(error, QStringLiteral("Unsupported installation request."));
+    }
+    const auto rules = installation.value(QStringLiteral("rules")).toArray();
+    if (rules.isEmpty() || rules.size() > 128) {
+        return fail(error, QStringLiteral("Invalid installation rule count."));
+    }
+    QSet<QString> referenced;
+    for (const auto &entry : rules) {
+        const auto rule = entry.toObject();
+        const auto condition = rule.value(QStringLiteral("when")).toObject();
+        const auto id = condition.value(QStringLiteral("control")).toString();
+        if (!entry.isObject() || !keys(rule, {QStringLiteral("when"), QStringLiteral("operation")}) || !rule.value(QStringLiteral("when")).isObject()
+            || !keys(condition, {QStringLiteral("control"), QStringLiteral("equals")}) || !ids.contains(id)
+            || !condition.value(QStringLiteral("equals")).isBool()) {
+            return fail(error, QStringLiteral("Invalid installation condition."));
+        }
+        const auto action = rule.value(QStringLiteral("operation")).toObject();
+        if (!rule.value(QStringLiteral("operation")).isObject() || !keys(action, {QStringLiteral("type"), QStringLiteral("directories")})
+            || action.value(QStringLiteral("type")).toString() != QLatin1String("omitDirectories") || !action.value(QStringLiteral("directories")).isArray()) {
+            return fail(error, QStringLiteral("Unsupported installation operation."));
+        }
+        QStringList directories;
+        const auto paths = action.value(QStringLiteral("directories")).toArray();
+        if (paths.isEmpty() || paths.size() > 256) {
+            return fail(error, QStringLiteral("Invalid action directory count."));
+        }
+        for (const auto &pathValue : paths) {
+            const auto path = pathValue.toString();
+            const QFileInfo file(root + path);
+            if (!pathValue.isString() || !relativePath(path) || !registered.contains(path) || controlled.contains(path) || !file.isDir()
+                || !file.canonicalFilePath().startsWith(root)) {
+                return fail(error, QStringLiteral("Invalid action path: %1").arg(path));
+            }
+            directories.append(path);
+            controlled.insert(path);
+        }
+        referenced.insert(id);
+        result.rules.append({id, condition.value(QStringLiteral("equals")).toBool(), directories});
+    }
+    if (referenced != ids) {
+        return fail(error, QStringLiteral("Every control must have an installation rule."));
+    }
+    // Nested action roots would make checkbox semantics ambiguous.
+    for (const auto &a : controlled) {
+        for (const auto &b : controlled) {
+            if (a != b && a.startsWith(b + QLatin1Char('/'))) {
+                return fail(error, QStringLiteral("Overlapping action directories."));
+            }
+        }
+    }
+    result.source = source;
+    result.title = object.value(QStringLiteral("title")).toString();
+    result.description = object.value(QStringLiteral("description")).toString();
+    return true;
+}
+
+bool applyThemeConfiguration(const ThemeConfiguration &configuration, const QMap<QString, bool> &values, QString &error)
+{
+    // Re-read untrusted data at Apply; never act on a caller-supplied path list.
+    ThemeConfiguration current;
+    if (!readThemeConfiguration(configuration.source, current, error) || !writableRoot(error)) {
+        return false;
+    }
+    QStringList excluded;
+    QSet<QString> expected;
+    for (const auto &page : current.pages) {
+        for (const auto &control : page.controls) {
+            expected.insert(control.id);
+            if (!values.contains(control.id)) {
+                return fail(error, QStringLiteral("Missing configuration value."));
+            }
+        }
+    }
+    if (values.size() != expected.size()) {
+        return fail(error, QStringLiteral("Unexpected configuration value."));
+    }
+    for (const auto &rule : current.rules) {
+        if (values.value(rule.control) == rule.equals) {
+            excluded.append(rule.directories);
+        }
+    }
+    const auto root = outputRoot();
+    const auto target = ownerPath(current.source);
+    const bool localSource = current.source == target;
+    const QString retainedSource = root + QStringLiteral("/.icon-config-sources/") + configuredThemeId(current.source);
+    QLockFile lock(root + QLatin1Char('/') + configuredThemeId(current.source) + QStringLiteral(".lock"));
+    if (!lock.tryLock()) {
+        return fail(error, QStringLiteral("Another configuration operation is running."));
+    }
+    const bool existing = QFileInfo::exists(target) || QFileInfo(target).isSymLink();
+    if (existing && !localSource) {
+        KConfig previous(target + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+        const KConfigGroup marker(&previous, QStringLiteral("X-KDE-GeneratedIconConfiguration"));
+        if (QFileInfo(target).isSymLink() || marker.readEntry("Version", 0) != 1 || marker.readEntry("Source", QString()) != current.source) {
+            return fail(error, QStringLiteral("Refusing to replace an unmanaged user theme."));
+        }
+    }
+    if (localSource) {
+        const auto retainedRoot = QFileInfo(retainedSource).path();
+        if (!QDir().mkpath(retainedRoot) || QFileInfo(retainedRoot).canonicalFilePath() != retainedRoot || (QFileInfo::exists(retainedSource) && !QDir(retainedSource).removeRecursively())
+            || QFileInfo(retainedSource).isSymLink()) {
+            return fail(error, QStringLiteral("Cannot preserve the original user theme."));
+        }
+    }
+    QTemporaryDir stage(root + QStringLiteral("/.icon-config-XXXXXX"));
+    if (!stage.isValid()) {
+        return fail(error, QStringLiteral("Cannot stage the configured theme."));
+    }
+    const auto sourceRoot = current.source + QLatin1Char('/');
+    const auto omitted = [&excluded](const QString &path) {
+        return std::any_of(excluded.cbegin(), excluded.cend(), [&path](const auto &directory) {
+            return path == directory || path.startsWith(directory + QLatin1Char('/'));
+        });
+    };
+    // Dereference individual files, never directory symlinks; no output symlinks
+    // are created. Escaping source links are rejected, even for icon aliases.
+    QDirIterator iterator(current.source, QDir::AllEntries | QDir::NoDotAndDotDot | QDir::Hidden, QDirIterator::Subdirectories);
+    qsizetype total = 0;
+    int files = 0;
+    while (iterator.hasNext()) {
+        const auto path = iterator.next();
+        const auto relative = QDir(current.source).relativeFilePath(path);
+        if (omitted(relative) || relative == QLatin1String("index.theme") || relative == QLatin1String("icon-settings.json")) {
+            continue;
+        }
+        const QFileInfo info(path);
+        const auto canonical = info.canonicalFilePath();
+        if (!relativePath(relative) || !canonical.startsWith(sourceRoot) || (info.isDir() && info.isSymLink())) {
+            return fail(error, QStringLiteral("Refusing unsafe theme path: %1").arg(relative));
+        }
+        const auto destination = stage.path() + QLatin1Char('/') + relative;
+        if (info.isDir()) {
+            if (!QDir().mkpath(destination)) {
+                return fail(error, QStringLiteral("Cannot create an artwork directory."));
+            }
+        } else if (info.isFile()) {
+            if (!QStringList{QStringLiteral("png"), QStringLiteral("svg"), QStringLiteral("svgz"), QStringLiteral("xpm")}.contains(info.suffix().toLower())) {
+                continue;
+            }
+            if (++files > 100000 || info.size() > 32 * 1024 * 1024 || (total += info.size()) > 2LL * 1024 * 1024 * 1024) {
+                return fail(error, QStringLiteral("Theme copy exceeds safety limits."));
+            }
+            if (!QDir().mkpath(QFileInfo(destination).path()) || !copyArtwork(canonical, destination)) {
+                return fail(error, QStringLiteral("Cannot copy artwork: %1").arg(relative));
+            }
+        } else {
+            return fail(error, QStringLiteral("Unsupported theme file: %1").arg(relative));
+        }
+    }
+    if (!QFile::copy(sourceRoot + QStringLiteral("index.theme"), stage.path() + QStringLiteral("/index.theme"))
+        || !QFile::copy(sourceRoot + QStringLiteral("icon-settings.json"), stage.path() + QStringLiteral("/icon-settings.json"))) {
+        return fail(error, QStringLiteral("Cannot copy theme metadata."));
+    }
+    for (const auto &name : {QStringLiteral("index.theme"), QStringLiteral("icon-settings.json")}) {
+        if (!QFile::setPermissions(stage.path() + QLatin1Char('/') + name, QFile::ReadOwner | QFile::WriteOwner | QFile::ReadGroup | QFile::ReadOther)) {
+            return fail(error, QStringLiteral("Cannot set metadata permissions."));
+        }
+    }
+    {
+        KConfig index(stage.path() + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+        KConfigGroup theme(&index, QStringLiteral("Icon Theme"));
+        for (const auto &key : {QStringLiteral("Directories"), QStringLiteral("ScaledDirectories")}) {
+            auto directories = theme.readEntry(key, QStringList());
+            directories.removeIf(omitted);
+            theme.writeEntry(key, directories);
+        }
+        for (const auto &group : index.groupList()) {
+            if (omitted(group)) {
+                index.deleteGroup(group);
+            }
+        }
+        KConfigGroup marker(&index, QStringLiteral("X-KDE-GeneratedIconConfiguration"));
+        marker.writeEntry("Version", 1);
+        marker.writeEntry("Source", localSource ? retainedSource : current.source);
+        KConfigGroup settings(&index, QStringLiteral("X-KDE-IconConfigurationValues"));
+        settings.deleteGroup();
+        for (auto i = values.cbegin(); i != values.cend(); ++i) {
+            settings.writeEntry(i.key(), i.value());
+        }
+        if (!index.sync()) {
+            return fail(error, QStringLiteral("Cannot save theme settings."));
+        }
+    }
+    const QString backup = localSource ? retainedSource : QString(stage.path() + QStringLiteral("-previous"));
+    if (existing && !QDir().rename(target, backup)) {
+        return fail(error, QStringLiteral("Cannot preserve the previous configured theme."));
+    }
+    if (!QDir().rename(stage.path(), target)) {
+        if (existing && !QDir().rename(backup, target)) {
+            return fail(error, QStringLiteral("Activation and rollback failed. Previous theme remains at %1.").arg(backup));
+        }
+        return fail(error, QStringLiteral("Cannot activate the configured theme."));
+    }
+    stage.setAutoRemove(false);
+    if (existing && !localSource && !QDir(backup).removeRecursively()) {
+        return fail(error, QStringLiteral("Theme saved, but previous copy could not be removed: %1").arg(backup));
+    }
+    return true;
+}
diff --git a/kcms/icons/themeconfigdialog.cpp b/kcms/icons/themeconfigdialog.cpp
new file mode 100644
index 0000000..2d31718
--- /dev/null
+++ b/kcms/icons/themeconfigdialog.cpp
@@ -0,0 +1,207 @@
+// SPDX-FileCopyrightText: 2026 Oxygen contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "themeconfig.h"
+#include <KConfig>
+#include <KConfigGroup>
+#include <QApplication>
+#include <QCheckBox>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QDir>
+#include <QFileInfo>
+#include <QIcon>
+#include <QLabel>
+#include <QMessageBox>
+#include <QPushButton>
+#include <QStandardPaths>
+#include <QStyle>
+#include <QStyleFactory>
+#include <QTabWidget>
+#include <QThread>
+#include <QTimer>
+#include <QVBoxLayout>
+#include <cstdio>
+#include <memory>
+
+class ConfigurationDialog : public QDialog
+{
+public:
+    bool saving = false;
+    void reject() override
+    {
+        if (!saving) {
+            QDialog::reject();
+        }
+    }
+};
+
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    app.setApplicationName(QStringLiteral("plasma-icon-theme-config"));
+    const auto arguments = app.arguments();
+    if (arguments.size() < 2) {
+        std::fprintf(stderr, "An installed theme directory is required.\n");
+        return 1;
+    }
+    ThemeConfiguration configuration;
+    QString error;
+    if (!readThemeConfiguration(arguments.at(1), configuration, error)) {
+        std::fprintf(stderr, "%s\n", qPrintable(error));
+        return 1;
+    }
+    const bool defaultsOnly = arguments.contains(QStringLiteral("--apply-defaults"));
+    const bool disableAll = arguments.contains(QStringLiteral("--disable-all"));
+    QMap<QString, bool> values;
+    const auto target =
+        QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons/") + configuredThemeId(configuration.source);
+    KConfig saved(target + QStringLiteral("/index.theme"), KConfig::SimpleConfig);
+    const KConfigGroup stored(&saved, QStringLiteral("X-KDE-IconConfigurationValues"));
+    for (const auto &page : configuration.pages) {
+        for (const auto &control : page.controls) {
+            values.insert(control.id, disableAll ? false : defaultsOnly ? control.defaultValue : stored.readEntry(control.id, control.defaultValue));
+        }
+    }
+    if (defaultsOnly || disableAll) {
+        if (!applyThemeConfiguration(configuration, values, error)) {
+            std::fprintf(stderr, "%s\n", qPrintable(error));
+            return 1;
+        }
+        return 0;
+    }
+    // Use the session-selected appearance even in a test session with an
+    // incomplete platform integration. No theme supplies style/plugin names.
+    KConfig globals(QStringLiteral("kdeglobals"));
+    const auto styleName = KConfigGroup(&globals, QStringLiteral("KDE")).readEntry("widgetStyle", QString());
+    if (!styleName.isEmpty()) {
+        auto *style = QStyleFactory::create(styleName);
+        if (!style) {
+            std::fprintf(stderr, "Cannot load session style: %s\n", qPrintable(styleName));
+            return 1;
+        }
+        app.setStyle(style);
+    }
+    auto iconTheme = KConfigGroup(&globals, QStringLiteral("Icons")).readEntry("Theme", QString());
+    for (const auto &root : QStandardPaths::standardLocations(QStandardPaths::GenericDataLocation)) {
+        QDir icons(root + QStringLiteral("/icons"));
+        if (QFileInfo::exists(icons.filePath(iconTheme + QStringLiteral("/index.theme")))) {
+            break;
+        }
+        bool found = false;
+        for (const auto &name : icons.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+            if (name.compare(iconTheme, Qt::CaseInsensitive) == 0) {
+                iconTheme = name;
+                found = true;
+                break;
+            }
+        }
+        if (found) {
+            break;
+        }
+    }
+    if (!iconTheme.isEmpty()) {
+        QIcon::setThemeName(iconTheme);
+    }
+    ConfigurationDialog dialog;
+    dialog.setWindowTitle(configuration.title);
+    dialog.setWindowIcon(QIcon::fromTheme(QStringLiteral("preferences-desktop-icons")));
+    dialog.setMinimumWidth(450);
+    auto *layout = new QVBoxLayout(&dialog);
+    auto *description = new QLabel(configuration.description);
+    description->setTextFormat(Qt::PlainText);
+    description->setWordWrap(true);
+    description->setMaximumWidth(600);
+    layout->addWidget(description);
+    auto *tabs = new QTabWidget;
+    tabs->setObjectName(QStringLiteral("configurationPages"));
+    layout->addWidget(tabs);
+    QMap<QString, QCheckBox *> controls;
+    for (const auto &page : configuration.pages) {
+        auto *widget = new QWidget;
+        auto *pageLayout = new QVBoxLayout(widget);
+        for (const auto &control : page.controls) {
+            auto *box = new QCheckBox(control.label);
+            box->setObjectName(control.id);
+            box->setChecked(values.value(control.id));
+            controls.insert(control.id, box);
+            pageLayout->addWidget(box);
+        }
+        pageLayout->addStretch();
+        tabs->addTab(widget, page.title);
+    }
+    auto *notice = new QLabel(QApplication::translate("ThemeConfig",
+                                                      "Save applies these settings to this icon theme for your user. System files stay unchanged. "
+                                                      "Normal size and inherited-theme fallback still applies."));
+    notice->setWordWrap(true);
+    notice->setMaximumWidth(600);
+    layout->addWidget(notice);
+    auto *sourceNotice = new QLabel(QApplication::translate("ThemeConfig", "Original theme: %1").arg(configuration.source));
+    sourceNotice->setTextFormat(Qt::PlainText);
+    sourceNotice->setWordWrap(true);
+    sourceNotice->setMaximumWidth(600);
+    layout->addWidget(sourceNotice);
+    auto *buttons = new QDialogButtonBox(QDialogButtonBox::Save | QDialogButtonBox::Cancel | QDialogButtonBox::RestoreDefaults);
+    buttons->button(QDialogButtonBox::Save)->setIcon(QIcon::fromTheme(QStringLiteral("document-save")));
+    buttons->button(QDialogButtonBox::Cancel)->setIcon(QIcon::fromTheme(QStringLiteral("dialog-cancel")));
+    buttons->button(QDialogButtonBox::RestoreDefaults)->setIcon(QIcon::fromTheme(QStringLiteral("edit-undo")));
+    layout->addWidget(buttons);
+    QObject::connect(buttons->button(QDialogButtonBox::RestoreDefaults), &QPushButton::clicked, &dialog, [&]() {
+        for (const auto &page : configuration.pages) {
+            for (const auto &control : page.controls) {
+                controls.value(control.id)->setChecked(control.defaultValue);
+            }
+        }
+    });
+    QObject::connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+    QObject::connect(buttons, &QDialogButtonBox::accepted, &dialog, [&]() {
+        if (dialog.saving) {
+            return;
+        }
+        for (auto i = controls.cbegin(); i != controls.cend(); ++i) {
+            values.insert(i.key(), i.value()->isChecked());
+        }
+        struct SaveResult {
+            bool success = false;
+            QString error;
+        };
+        const auto result = std::make_shared<SaveResult>();
+        dialog.saving = true;
+        buttons->setEnabled(false);
+        tabs->setEnabled(false);
+        notice->setText(QApplication::translate("ThemeConfig", "Saving icon theme settings..."));
+        dialog.setCursor(Qt::BusyCursor);
+        auto *worker = QThread::create([configuration, values, result]() {
+            result->success = applyThemeConfiguration(configuration, values, result->error);
+        });
+        QObject::connect(worker, &QThread::finished, &dialog, [&, result, worker]() {
+            worker->deleteLater();
+            dialog.saving = false;
+            dialog.unsetCursor();
+            if (result->success) {
+                dialog.accept();
+            } else {
+                buttons->setEnabled(true);
+                tabs->setEnabled(true);
+                notice->setText(QApplication::translate("ThemeConfig", "Settings were not saved. Correct the error and try again."));
+                QMessageBox::critical(&dialog, dialog.windowTitle(), result->error);
+            }
+        });
+        worker->start();
+    });
+    if (arguments.contains(QStringLiteral("--smoke-test"))) {
+        QTimer::singleShot(1000, &dialog, [&]() {
+            std::fprintf(stderr,
+                         "Widget style: %s; icon theme: %s; pages: %d; controls: %lld\n",
+                         qPrintable(app.style()->objectName()),
+                         qPrintable(QIcon::themeName()),
+                         tabs->count(),
+                         static_cast<long long>(controls.size()));
+            const auto image = qEnvironmentVariable("ICON_CONFIG_SCREENSHOT");
+            if (!image.isEmpty() && !dialog.grab().save(image)) {
+                std::fprintf(stderr, "Cannot save screenshot.\n");
+            }
+            dialog.reject();
+        });
+    }
+    return dialog.exec() == QDialog::Accepted ? 0 : 2;
+}
