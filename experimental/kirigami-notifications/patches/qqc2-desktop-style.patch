diff --git a/kirigami/InlineMessage.qml b/kirigami/InlineMessage.qml
new file mode 100644
index 0000000000000000000000000000000000000000..b0ae45d0b3c826beb4ff41423fe257edf0077b39
--- /dev/null
+++ b/kirigami/InlineMessage.qml
@@ -0,0 +1,131 @@
+// SPDX-FileCopyrightText: 2018 Eike Hein <hein@kde.org>
+// SPDX-FileCopyrightText: 2018 Marco Martin <mart@kde.org>
+// SPDX-FileCopyrightText: 2018 Kai Uwe Broulik <kde@privat.broulik.de>
+// SPDX-License-Identifier: LGPL-2.0-or-later
+import QtQuick
+import org.kde.qqc2desktopstyle.private as Desktop
+import org.kde.kirigami.controls as Controls
+import org.kde.kirigami.platform as Platform
+import org.kde.kirigami.templates as Templates
+
+Templates.InlineMessage {
+    id: banner
+
+    readonly property color statusColor: {
+        switch (type) {
+        case Controls.MessageType.Positive: return Platform.Theme.positiveTextColor
+        case Controls.MessageType.Warning: return Platform.Theme.neutralTextColor
+        case Controls.MessageType.Error: return Platform.Theme.negativeTextColor
+        default: return Platform.Theme.activeTextColor
+        }
+    }
+
+    readonly property string severity: {
+        switch (type) {
+        case Controls.MessageType.Positive: return "positive"
+        case Controls.MessageType.Warning: return "warning"
+        case Controls.MessageType.Error: return "error"
+        default: return "information"
+        }
+    }
+
+    readonly property bool inset: position === Templates.InlineMessage.Position.Inline
+    // Older Kirigami templates retain their default presentation.
+    readonly property bool widgetFrame: nativeItem.styleDrawsInlineMessage && ("leadingIconInset" in banner)
+
+    icon.name: {
+        if (!widgetFrame || icon.source) return ""
+        switch (type) {
+        case Controls.MessageType.Positive: return "dialog-positive"
+        case Controls.MessageType.Warning: return "dialog-warning"
+        case Controls.MessageType.Error: return "dialog-error"
+        default: return "dialog-information"
+        }
+    }
+
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "messageRenderType"
+        value: Text.NativeRendering
+    }
+
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "labelVerticalOffset"
+        value: -1
+    }
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "leadingIconInset"
+        value: 0
+    }
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "iconLabelSpacing"
+        value: nativeItem.pixelMetric("layouthorizontalspacing")
+    }
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "closeIcon.width"
+        value: nativeItem.pixelMetric("smalliconsize")
+    }
+    Binding {
+        target: banner.widgetFrame ? banner : null
+        property: "closeIcon.height"
+        value: nativeItem.pixelMetric("smalliconsize")
+    }
+
+    readonly property bool hasStylePadding: widgetFrame && nativeItem.inlineMessagePadding.width >= 0
+        && nativeItem.inlineMessagePadding.height >= 0
+    readonly property bool insetHeader: widgetFrame && position === Templates.InlineMessage.Position.Header
+    leftInset: insetHeader ? Math.max(0, nativeItem.inlineMessageHeaderInset.width) : 0
+    rightInset: leftInset
+    topInset: insetHeader ? Math.max(0, nativeItem.inlineMessageHeaderInset.height) : 0
+    bottomInset: topInset
+
+    leftPadding: leftInset + (hasStylePadding ? nativeItem.inlineMessagePadding.width : Platform.Units.smallSpacing + (inset ? 1 : 0))
+    rightPadding: leftPadding
+    topPadding: topInset + (hasStylePadding ? nativeItem.inlineMessagePadding.height : Platform.Units.smallSpacing + (position === Templates.InlineMessage.Position.Header ? 0 : 1))
+    bottomPadding: bottomInset + (hasStylePadding ? nativeItem.inlineMessagePadding.height : Platform.Units.smallSpacing + (position === Templates.InlineMessage.Position.Footer ? 0 : 1))
+
+    background: Item {
+        Desktop.StyleItem {
+            id: nativeItem
+            anchors.fill: parent
+            control: banner
+            visible: banner.widgetFrame
+            active: banner.Window.active
+            elementType: visible ? "inlinemessage" : "widget"
+            properties: ({
+                background: banner.palette.window,
+                accent: nativeItem.inlineMessageColors[banner.severity] ?? banner.statusColor,
+                severity: banner.severity,
+                position: banner.position
+            })
+        }
+
+        Rectangle {
+            anchors.fill: parent
+            visible: !nativeItem.visible
+            color: banner.statusColor
+            radius: banner.inset ? Platform.Units.cornerRadius : 0
+
+            Rectangle {
+                anchors.fill: parent
+                anchors.leftMargin: banner.inset ? 1 : 0
+                anchors.rightMargin: anchors.leftMargin
+                anchors.topMargin: banner.position === Templates.InlineMessage.Position.Header ? 0 : 1
+                anchors.bottomMargin: banner.position === Templates.InlineMessage.Position.Footer ? 0 : 1
+                radius: parent.radius * 0.60
+                color: banner.Platform.Theme.backgroundColor
+
+                Rectangle {
+                    anchors.fill: parent
+                    radius: parent.radius
+                    color: banner.statusColor
+                    opacity: 0.20
+                }
+            }
+        }
+    }
+}
diff --git a/plugin/kquickstyleitem.cpp b/plugin/kquickstyleitem.cpp
index 28e3012604827da4340db042ad2d9736d4e01e9f..f414189c318b34d03b829482f281adbe01c31e49 100644
--- a/plugin/kquickstyleitem.cpp
+++ b/plugin/kquickstyleitem.cpp
@@ -1022,6 +1022,27 @@ int KQuickStyleItem::padding(Qt::Edge edge) const
     return 0;
 }
 
+QSize KQuickStyleItem::inlineMessageHeaderInset() const
+{
+    return style()->property("kdeInlineMessageHeaderInset").toSize();
+}
+
+QSize KQuickStyleItem::inlineMessagePadding() const
+{
+    const QVariant padding = style()->property("kdeInlineMessagePadding");
+    return padding.canConvert<QSize>() ? padding.toSize() : QSize();
+}
+
+bool KQuickStyleItem::styleDrawsInlineMessage() const
+{
+    return style()->property("kdeInlineMessageControlElement").toUInt() != 0;
+}
+
+QVariantMap KQuickStyleItem::inlineMessageColors() const
+{
+    return style()->property("kdeInlineMessageColors").toMap();
+}
+
 /*
  *   Property style
  *
@@ -1429,7 +1450,9 @@ void KQuickStyleItem::updateRect()
 
 int KQuickStyleItem::pixelMetric(const QString &metric)
 {
-    if (metric == QLatin1String("scrollbarExtent")) {
+    if (metric == QLatin1String("smalliconsize")) {
+        return style()->pixelMetric(QStyle::PM_SmallIconSize);
+    } else if (metric == QLatin1String("scrollbarExtent")) {
         return KQuickStyleItem::style()->pixelMetric(QStyle::PM_ScrollBarExtent, nullptr);
     } else if (metric == QLatin1String("defaultframewidth")) {
         return KQuickStyleItem::style()->pixelMetric(QStyle::PM_DefaultFrameWidth, m_styleoption);
@@ -1636,6 +1659,8 @@ void KQuickStyleItem::setElementType(const QString &str)
         m_itemType = ScrollBar;
     } else if (str == QLatin1String("widget")) {
         m_itemType = Widget;
+    } else if (str == QLatin1String("inlinemessage")) {
+        m_itemType = InlineMessage;
     } else if (str == QLatin1String("focusframe")) {
         m_itemType = FocusFrame;
     } else if (str == QLatin1String("focusrect")) {
@@ -1820,6 +1845,16 @@ void KQuickStyleItem::paint(QPainter *painter)
     case MacHelpButton:
         // Not managed as mac is not supported
         break;
+    case InlineMessage: {
+        const uint element = style()->property("kdeInlineMessageControlElement").toUInt();
+        if (element) {
+            QStyleOption message(*m_styleoption);
+            message.palette.setColor(QPalette::Window, m_properties.value(QStringLiteral("background")).value<QColor>());
+            message.palette.setColor(QPalette::Highlight, m_properties.value(QStringLiteral("accent")).value<QColor>());
+            style()->drawControl(static_cast<QStyle::ControlElement>(element), &message, painter);
+        }
+        break;
+    }
     case Widget:
         KQuickStyleItem::style()->drawPrimitive(QStyle::PE_Widget, m_styleoption, painter);
         break;
