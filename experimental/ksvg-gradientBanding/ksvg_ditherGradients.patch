+/*
+ * Gradients in theme SVGs often span only a few 8-bit levels over hundreds of pixels
+ * (dialog and panel backgrounds), so plain rounding produces wide visible bands.
+ * Theme files with gradients are therefore rendered at 16 bits per channel and quantized
+ * with 8x8 ordered dithering. This makes the banding go away.
+ */
+QImage ditherToArgb32(const QImage &source)
+{
+    Q_ASSERT(source.format() == QImage::Format_RGBA64_Premultiplied);
+
+    static constexpr int bayer[8][8] = {{0, 32, 8, 40, 2, 34, 10, 42},
+                                        {48, 16, 56, 24, 50, 18, 58, 26},
+                                        {12, 44, 4, 36, 14, 46, 6, 38},
+                                        {60, 28, 52, 20, 62, 30, 54, 22},
+                                        {3, 35, 11, 43, 1, 33, 9, 41},
+                                        {51, 19, 59, 27, 49, 17, 57, 25},
+                                        {15, 47, 7, 39, 13, 45, 5, 37},
+                                        {63, 31, 55, 23, 61, 29, 53, 21}};
+
+    QImage image(source.size(), QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(source.devicePixelRatio());
+
+    constexpr qreal scale(1.0 / 257.0);
+    for (int y = 0; y < source.height(); ++y) {
+        const auto in = reinterpret_cast<const QRgba64 *>(source.constScanLine(y));
+        auto out = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < source.width(); ++x) {
+            const qreal threshold((bayer[y & 7][x & 7] + 0.5) / 64.0 - 0.5);
+            const auto quantize = [threshold](quint16 value) {
+                return qBound(0, qRound(value * scale + threshold), 255);
+            };
+
+            // keep the premultiplied invariant: no color channel above alpha
+            const int alpha(quantize(in[x].alpha()));
+            out[x] = qRgba(qMin(quantize(in[x].red()), alpha), qMin(quantize(in[x].green()), alpha), qMin(quantize(in[x].blue()), alpha), alpha);
+        }
+    }
+
+    return image;
+}
+}
