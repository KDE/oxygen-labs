+
+bool Style::drawSwitchIndicator(const QStyleOption *option, QPainter *painter, const QWidget *widget) const
+{
+    const auto *slider = qstyleoption_cast<const QStyleOptionSlider *>(option);
+    if (!slider || option->rect.isEmpty()) {
+        return false;
+    }
+
+    const QRect rect = option->rect;
+    const QPalette &palette = option->palette;
+    const bool enabled = option->state & State_Enabled;
+    const bool checked = option->state & State_On;
+    const QColor track = checked ? palette.color(enabled ? palette.currentColorGroup() : QPalette::Disabled, QPalette::Highlight) : palette.color(QPalette::Window);
+
+    const QRectF rim(rect);
+    const QRectF well = rim.adjusted(0.8, 0.8, -0.8, -0.8);
+    const QColor base = checked ? track : _helper->calcDarkColor(track);
+    const QColor shadow = _helper->calcShadowColor(track);
+    QLinearGradient lip(rim.topLeft(), rim.bottomLeft());
+    lip.setColorAt(0, KColorUtils::mix(base, shadow, 0.35));
+    lip.setColorAt(0.55, base);
+    lip.setColorAt(1, _helper->calcLightColor(track));
+
+    // Paint both contours at the target resolution, including fractional display scales.
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setPen(Qt::NoPen);
+    painter->setBrush(lip);
+    painter->drawRoundedRect(rim, rim.height() / 2, rim.height() / 2);
+    if (!well.isEmpty()) {
+        QLinearGradient inset(well.topLeft(), well.bottomLeft());
+        inset.setColorAt(0, KColorUtils::mix(base, shadow, 0.38));
+        inset.setColorAt(0.14, KColorUtils::mix(base, shadow, 0.12));
+        inset.setColorAt(0.55, base);
+        inset.setColorAt(1, KColorUtils::mix(base, track, 0.18));
+        painter->setBrush(inset);
+        painter->drawRoundedRect(well, well.height() / 2, well.height() / 2);
+
+        constexpr qreal shadowWidth = 1.4;
+        const qreal halfWidth = shadowWidth / 2;
+        const QRectF edge = well.adjusted(halfWidth, halfWidth, -halfWidth, -halfWidth);
+        QLinearGradient edgeShadow(well.topLeft(), well.bottomLeft());
+        edgeShadow.setColorAt(0, _helper->alphaColor(shadow, 0.30));
+        edgeShadow.setColorAt(0.5, _helper->alphaColor(shadow, 0.14));
+        edgeShadow.setColorAt(1, _helper->alphaColor(shadow, 0.035));
+        painter->setPen(QPen(edgeShadow, shadowWidth));
+        painter->setBrush(Qt::NoBrush);
+        painter->drawRoundedRect(edge, edge.height() / 2, edge.height() / 2);
+    }
+
+    const QRect interior = rect.adjusted(switchHandleInset, switchHandleInset, -switchHandleInset, -switchHandleInset);
+    if (interior.isEmpty()) {
+        return true;
+    }
+    const int size = qMin(interior.width(), interior.height());
+    const int travel = interior.width() - size;
+    const int x = sliderPositionFromValue(slider->minimum, slider->maximum, slider->sliderPosition, travel);
+    const QRect handle(interior.left() + x, rect.top() + (rect.height() - size) / 2, size, size);
+    StyleOptions states;
+    if (enabled && (option->state & State_HasFocus)) {
+        states |= Focus;
+    }
+    if (enabled && (option->state & State_MouseOver)) {
+        states |= Hover;
+    }
+    const QColor color = _helper->backgroundColor(palette.color(QPalette::Button), widget, handle.center());
+    const QColor glow = _helper->buttonGlowColor(palette, states, -1, AnimationNone);
+    _helper->renderSwitchHandle(*painter, handle, color, glow, option->state & State_Sunken);
+    return true;
+}
