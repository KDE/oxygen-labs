+//__________________________________________________________________________________________________________
+void StyleHelper::renderSwitchHandle(QPainter &painter, const QRectF &face, const QColor &color, const QColor &glow, bool sunken)
+{
+    painter.save();
+    const qreal radius = face.width() / 2;
+    const qreal spread = 0.72;
+    const QPointF center = face.center() + QPointF(0, sunken ? 0.2 : 0.52);
+    QRadialGradient contact(center, radius + spread);
+    const QColor shadow = calcShadowColor(color);
+    contact.setColorAt(radius / (radius + spread), alphaColor(shadow, 0.42));
+    contact.setColorAt(1, alphaColor(shadow, 0));
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(contact);
+    painter.drawEllipse(center, radius + spread, radius + spread);
+    if (glow.isValid()) {
+        painter.setBrush(Qt::NoBrush);
+        painter.setPen(QPen(glow, 1.2));
+        painter.drawEllipse(face.adjusted(-0.4, -0.4, 0.4, 0.4));
+    }
+
+    // The slider face occupies (3, 3, 15, 15) in the slab's logical coordinates.
+    painter.translate(face.topLeft());
+    painter.scale(face.width() / 15, face.height() / 15);
+    painter.translate(-3, -3);
+    drawSliderSlab(painter, color, sunken, 0);
+    painter.restore();
+}
