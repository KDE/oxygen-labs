+
+//____________________________________________________________________
+QImage Helper::ditheredVerticalGradient(const QGradientStops &stops, qreal start, qreal end, int height, qreal dpr) const
+{
+    Q_ASSERT(stops.size() >= 2);
+
+    // computed directly rather than painted, so it can be dithered (see ditheredPixel).
+    // The tile is 8 device pixels wide so it can hold the 2D dither pattern
+    QImage image(8, qMax(1, qRound(height * dpr)), QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(dpr);
+
+    const qreal span(end - start);
+    for (int y = 0; y < image.height(); ++y) {
+        // gradient position at the device pixel center, in logical coordinates, padded at both ends
+        const qreal t(span > 0 ? qBound<qreal>(0, ((y + 0.5) / dpr - start) / span, 1) : 0);
+
+        int index(1);
+        while (index < stops.size() - 1 && stops.at(index).first < t) {
+            ++index;
+        }
+
+        const QColor &from(stops.at(index - 1).second);
+        const QColor &to(stops.at(index).second);
+        const qreal range(stops.at(index).first - stops.at(index - 1).first);
+        const qreal f(range > 0 ? qBound<qreal>(0, (t - stops.at(index - 1).first) / range, 1) : 0);
+
+        // interpolate premultiplied colors, like QGradient does
+        const auto channel = [f](qreal a, qreal b) {
+            return 255 * (a + (b - a) * f);
+        };
+        const qreal alpha(channel(from.alphaF(), to.alphaF()));
+        const qreal red(channel(from.redF() * from.alphaF(), to.redF() * to.alphaF()));
+        const qreal green(channel(from.greenF() * from.alphaF(), to.greenF() * to.alphaF()));
+        const qreal blue(channel(from.blueF() * from.alphaF(), to.blueF() * to.alphaF()));
+
+        auto line = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < image.width(); ++x) {
+            line[x] = ditheredPixel(red, green, blue, alpha, x, y);
+        }
+    }
+
+    return image;
+}
