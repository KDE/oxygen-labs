+/*
+ * Oxygen's window background gradients span only a few 8-bit levels over hundreds of pixels,
+ * so plain rounding produces wide visible bands. This makes the banding go away.
+ */
+inline qreal ditherThreshold(int x, int y)
+{
+    static constexpr int bayer[8][8] = {{0, 32, 8, 40, 2, 34, 10, 42},
+                                        {48, 16, 56, 24, 50, 18, 58, 26},
+                                        {12, 44, 4, 36, 14, 46, 6, 38},
+                                        {60, 28, 52, 20, 62, 30, 54, 22},
+                                        {3, 35, 11, 43, 1, 33, 9, 41},
+                                        {51, 19, 59, 27, 49, 17, 57, 25},
+                                        {15, 47, 7, 39, 13, 45, 5, 37},
+                                        {63, 31, 55, 23, 61, 29, 53, 21}};
+    return (bayer[y & 7][x & 7] + 0.5) / 64.0 - 0.5;
+}
+
+//* quantize premultiplied channels given in 8-bit units (0-255, fractional) to a dithered pixel
+inline QRgb ditheredPixel(qreal red, qreal green, qreal blue, qreal alpha, int x, int y)
+{
+    const qreal threshold(ditherThreshold(x, y));
+    const auto quantize = [threshold](qreal value) {
+        return qBound(0, qRound(value + threshold), 255);
+    };
+
+    // keep the premultiplied invariant: no color channel above alpha
+    const int a(quantize(alpha));
+    return qRgba(qMin(quantize(red), a), qMin(quantize(green), a), qMin(quantize(blue), a), a);
+}
+
+//* dither a 16-bit-per-channel premultiplied image down to ARGB32 premultiplied
+QImage ditherToArgb32(const QImage &source)
+{
+    Q_ASSERT(source.format() == QImage::Format_RGBA64_Premultiplied);
+
+    QImage image(source.size(), QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(source.devicePixelRatio());
+
+    constexpr qreal scale(1.0 / 257.0);
+    for (int y = 0; y < source.height(); ++y) {
+        const auto in = reinterpret_cast<const QRgba64 *>(source.constScanLine(y));
+        auto out = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < source.width(); ++x) {
+            out[x] = ditheredPixel(in[x].red() * scale, in[x].green() * scale, in[x].blue() * scale, in[x].alpha() * scale, x, y);
+        }
+    }
+
+    return image;
+}
+}
