+//________________________________________________________________________________________________________
+QPixmap StyleHelper::groupBoxGradient(const QColor &color, int height, qreal dpr)
+{
+    const quint64 dprKey(quint64(qRound(dpr * 64.0)));
+    const quint64 key((colorKey(color) << 32) | (dprKey << 16) | quint64(qBound(0, height, 0xffff)));
+    if (QPixmap *cachedPixmap = _groupBoxGradientCache.object(key)) {
+        return *cachedPixmap;
+    }
+
+    // same as QLinearGradient(0, top - height + 12, 0, bottom + height - 19), relative to the top
+    QColor light(calcLightColor(color));
+    light.setAlphaF(0.4);
+    QColor transparent(light);
+    transparent.setAlphaF(0);
+
+    QImage image(ditheredVerticalGradient({{0.0, light}, {1.0, transparent}}, -height + 12, 2 * height - 20, height, dpr));
+
+    // device pixels only: a texture brush with a devicePixelRatio would be emulated (and resampled) by QPainter
+    image.setDevicePixelRatio(1);
+    const QPixmap pixmap(QPixmap::fromImage(image));
+
+    _groupBoxGradientCache.insert(key, new QPixmap(pixmap));
+    return pixmap;
+}
