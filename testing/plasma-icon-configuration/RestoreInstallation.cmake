cmake_minimum_required(VERSION 3.29)
if(NOT DEFINED BACKUP_DIR OR NOT EXISTS "${BACKUP_DIR}/manifest.cmake")
    message(FATAL_ERROR "Set BACKUP_DIR to the backup path printed during installation")
endif()
include("${BACKUP_DIR}/manifest.cmake")
foreach(i RANGE 0 1)
    set(destination "${destination_${i}}")
    if(IS_SYMLINK "${destination}" OR IS_DIRECTORY "${destination}" OR NOT EXISTS "${destination}")
        message(FATAL_ERROR "Installed file is absent or was replaced: ${destination}")
    endif()
    file(SHA256 "${destination}" current_hash)
    if(NOT current_hash STREQUAL installed_hash_${i})
        message(FATAL_ERROR "File changed since installation; refusing rollback: ${destination}")
    endif()
    if(DEFINED original_hash_${i})
        file(SHA256 "${BACKUP_DIR}/original-${i}" backup_hash)
        if(NOT backup_hash STREQUAL original_hash_${i})
            message(FATAL_ERROR "Original backup checksum mismatch")
        endif()
    endif()
endforeach()
foreach(i RANGE 0 1)
    set(destination "${destination_${i}}")
    if(DEFINED original_hash_${i})
        file(COPY_FILE "${BACKUP_DIR}/original-${i}" "${destination}.icon-configuration-restore")
        file(RENAME "${destination}.icon-configuration-restore" "${destination}")
    else()
        file(REMOVE "${destination}")
    endif()
endforeach()
message(STATUS "Original Icons settings restored. Close and reopen System Settings.")
